# Ignore the contents of the _site directory
_site/

# Ignore the directory for local files during development
local/
/_site/
/vendor/
.bundle/

archives/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# Local working materials (bio drafts etc.) - not for the public repo
resources/

# CV source folder (Word master + exported PDFs live here; only files/*.pdf is published)
cv_source/archives_old/
cv_source/cv_pdf_archive/
cv_source/*_tmp_*
~$*
.DS_Store
Gemfile.lock.*-bak

# LaTeX build artifacts of the CV (only cv_source/latex/cv.tex is tracked)
cv_source/latex/*.pdf
cv_source/latex/*.aux
cv_source/latex/*.log
cv_source/latex/*.out
cv_source/latex/*.xdv
cv_source/latex/*.fls
cv_source/latex/*.fdb_latexmk
cv_source/latex/*.synctex.gz
